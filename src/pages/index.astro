---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Mac from '../components/Mac.astro';
import Glyph from '../components/Glyph.astro';
import StoreCta from '../components/StoreCta.astro';
import { MAC_MIN_OS, IOS_MIN_OS } from '../config.mjs';

/* Every claim below was checked against the shipped app source before it was
   written, and re-checked by an adversarial audit afterwards — the comments
   above the entries it corrected record what the code actually does.

   Deliberately absent, because the app does not do them: screen mirroring,
   brightness, pinch-to-zoom, and control from outside your own network. */
const CAPS = [
  { g: 'dpad', t: 'A real trackpad', size: 'feature',
    d: 'Move, tap to click, double-tap, two-finger tap to right-click, two-finger scroll, and tap-and-a-half to drag. It feels like the glass came off a MacBook.' },
  // NOT "keys repeat when held": SettingsStore.arrowRepeat defaults to
  // .tapOnly, and KeyRepeater is only wired to the arrow pad and to seek.
  // NOT "latch for the next keystroke": SettingsStore.latchMode defaults to
  // .doubleTapLock, not .oneShot.
  { g: 'keyboard', t: 'The whole keyboard', size: 'wide',
    d: '⌘ ⌃ ⌥ ⇧ arm for the next keystroke, or double-tap one to lock it on. What you type resolves against the Mac’s own layout, and follows it when you switch input source.' },
  { g: 'mic', t: 'Dictation that stays on the phone',
    d: 'Hold to talk, or swipe up to lock it hands-free. Recognition is on-device only — server recognition is refused outright, never quietly substituted.' },
  // NOT "what you see is the Mac's actual level": the host emits volumeState on
  // connect and after a phone-issued command, but registers no CoreAudio
  // property listener, so changing volume ON the Mac does not push an update.
  { g: 'playpause', t: 'Media and volume',
    d: 'Real media keys, and a volume bar that reads the Mac’s actual level rather than guessing at one.' },
  { g: 'desktops', t: 'Spaces and apps',
    d: 'Switch desktops, open Mission Control, and jump between running apps from a grid of their real icons, fetched live from the Mac.' },
  { g: 'bolt', t: 'Shortcuts you define',
    d: 'Build macros from modifiers and a key, and label each one with a symbol, some text, or one of your Mac’s own app icons.' },
  { g: 'mac', t: 'It shows you what you’re typing into',
    d: 'The phone names the Mac app that currently has focus, with its icon — so you are never typing blind into whatever happened to be in front.' },
  { g: 'phone', t: 'Several Macs, one phone',
    d: 'Pair as many as you like, rename them, and switch between them. Remove one and it forgets the phone right back.' },
  { g: 'lock', t: 'Lock it from across the room', size: 'full',
    d: 'Lock the screen outright, or press and hold to reach Restart and Shut Down behind a confirmation.' },
];
---
<Base
  wide
  title="ReMoKey — your iPhone is your Mac's keyboard and trackpad"
  description="Your iPhone becomes a trackpad, keyboard and media remote for your Mac. Over your own Wi-Fi, device to device — no account, no cloud, no screen mirroring."
>

  <!-- ═══ HERO ═══
       Two beats. The page opens on the headline with the phone standing beside
       it; as you scroll, the phone flies down to meet the Mac and the Mac's
       HUD flips from "Ready to pair" to "Connected" as it lands. The journey
       IS the pitch — the phone travels, the input arrives.

       The phone's layout position is its FINAL position (in front of the
       Mac). The opening position is only ever a transform, measured from an
       empty anchor box beside the headline — so with JS off, with reduced
       motion, or on a narrow screen, the phone simply stands where it lands
       and nothing is mispositioned. -->
  <section class="hero" data-hero>
    <div class="hero__bg" aria-hidden="true"></div>

    <div class="wrap hero__in">
      <div class="hero__grid">
        <div class="hero__copy">
          <p class="label reveal">ReMoKey for iPhone &amp; Mac</p>

          <h1 class="t-mega hero__h reveal" style="--reveal-delay:70ms">
            Across the room<br />is <span class="hl">close enough</span>.
          </h1>

          <p class="lede hero__lede reveal" style="--reveal-delay:150ms">
            Your iPhone becomes your Mac’s trackpad, keyboard and media
            remote. Sit back anywhere on your own <span class="nowrap">Wi-Fi</span> —
            every tap and keystroke lands on the Mac, device to device, with
            no cloud in between.
          </p>

          <div class="reveal" style="--reveal-delay:230ms">
            <StoreCta />
          </div>
        </div>

        <!-- Where the phone OPENS, not where it lives: an empty box the
             engine measures. Nothing renders inside it. -->
        <div class="hero__anchor" aria-hidden="true" data-journey-anchor></div>
      </div>

      <div class="stage">
        <div class="stage__mac">
          <!-- Two HUD states stacked. "Connected" is the in-flow layer and
               the default — it is what no-JS, reduced-motion and narrow
               viewports see. The journey swaps "ready" in until the phone
               lands. -->
          <div class="stage__macL stage__macL--ready" aria-hidden="true">
            <Mac hud="ready" waves={0} />
          </div>
          <div class="stage__macL stage__macL--connected">
            <Mac hud="connected" waves={3} />
          </div>
        </div>

        <!-- No connecting line and no radiating arcs between the two devices.
             Both were tried; both read as damage rather than signal, because
             any mark drawn in the overlap lands on the Mac's bezel. The pairing
             is said by the journey itself, and by the Mac's HUD flipping to
             Connected as the phone arrives. -->
        <div class="stage__phone" data-journey-slot>
          <div class="stage__phoneIn" data-journey-phone>
            <Phone screen="control" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE WALKTHROUGH ═══
       A sticky device beside three steps. Each step swaps the screen as it
       reaches the middle of the viewport. IntersectionObserver rather than a
       scrubbed timeline: it needs no per-frame work, it cannot desynchronise,
       and with no JS all three steps simply read as prose. -->
  <section class="walk" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <header class="walk__head reveal">
        <p class="label">How it works</p>
        <h2 class="t-xl" id="how-h">Three steps, once.<br />Then it just works.</h2>
      </header>
    </div>

    <div class="wrap walk__grid">
      <!-- Sticky device column -->
      <div class="walk__stick" aria-hidden="true">
        <div class="walk__devices">
          <div class="walk__layer is-on" data-layer="0"><Phone screen="connect" /></div>
          <div class="walk__layer" data-layer="1"><Phone screen="pair" /></div>
          <div class="walk__layer" data-layer="2"><Phone screen="control" /></div>
        </div>
        <div class="walk__mac">
          <div class="walk__layer is-on" data-maclayer="0"><Mac hud="ready" waves={0} /></div>
          <div class="walk__layer" data-maclayer="1"><Mac hud="code" waves={0} /></div>
          <div class="walk__layer" data-maclayer="2"><Mac hud="connected" waves={3} /></div>
        </div>
      </div>

      <!-- Steps -->
      <ol class="walk__steps" role="list">
        <li class="step" data-step="0">
          <div class="step__art" aria-hidden="true"><Phone screen="connect" /></div>
          <p class="label">Step 01 — Find</p>
          <h3 class="t-lg">It finds your Mac by itself.</h3>
          <p>
            Open ReMoKey with the Mac app running and your Mac appears — no
            addresses, no setup. iOS asks once for permission to see your local
            network; that is the whole of it.
          </p>
          <p class="step__aside">
            You can always type an address instead — which is also the answer
            over a VPN, or on the mesh and guest networks that quietly refuse to
            pass discovery traffic.
          </p>
        </li>

        <li class="step" data-step="1">
          <div class="step__art" aria-hidden="true"><Phone screen="pair" /></div>
          <p class="label">Step 02 — Confirm</p>
          <h3 class="t-lg">Two screens. One code.</h3>
          <p>
            Both devices work out the same four digits independently. You read
            them off your iPhone, check the Mac agrees, and press Confirm{' '}<em>on the Mac</em>. That comparison is the whole security boundary —
            there is no password to choose and none to leak.
          </p>
          <p class="step__aside">
            The Mac commits to its half of the exchange before your iPhone
            reveals its own, so nothing sitting in the middle can steer both
            ends to a code it picked.
          </p>
        </li>

        <li class="step" data-step="2">
          <div class="step__art" aria-hidden="true"><Phone screen="control" /></div>
          <p class="label">Step 03 — Control</p>
          <h3 class="t-lg">Then it’s just a trackpad.</h3>
          <p>
            The pad fills the phone. Four launchers float over it for arrow
            keys, media, desktops and the keyboard; the modifier row sits under
            your thumb. Pull the left edge for volume and zoom, the right edge
            to dictate.
          </p>
          <p class="step__aside">
            The Mac asks for Accessibility the first time — macOS will not let
            any app move your pointer without it. Skip it and the phone still
            connects, but the Mac quietly ignores everything it sends.
          </p>
          <p class="step__aside">
            Pair once. After that it connects by itself the moment you open it.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ CAPABILITIES ═══
       A bento, not a uniform grid: the trackpad is the product and earns the
       big cell with an illustration; the keyboard rides beside it; the rest
       hold a steady rhythm underneath. -->
  <section class="caps" aria-labelledby="caps-h">
    <div class="wrap">
      <header class="caps__head reveal">
        <p class="label">What it does</p>
        <h2 class="t-xl" id="caps-h">The whole Mac,<br />under one thumb.</h2>
      </header>

      <ul class="bento" role="list">
        {CAPS.map((c, i) => (
          <li class:list={['bcard', 'reveal', c.size && `bcard--${c.size}`]}
              style={`--reveal-delay:${(i % 3) * 70}ms`}>
            { c.size === 'feature' && (
              <svg class="bcard__art" viewBox="0 0 340 176" aria-hidden="true">
                <rect x="16" y="14" width="230" height="148" rx="14"
                      fill="var(--well)" stroke="var(--line)" />
                <path d="M 58 118 C 104 52, 172 122, 216 62" fill="none"
                      stroke="var(--signal)" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="216" cy="62" r="4" fill="var(--signal)" />
                <circle cx="216" cy="62" r="11" fill="none" stroke="var(--signal)"
                        stroke-opacity=".45" />
                <circle cx="216" cy="62" r="19" fill="none" stroke="var(--signal)"
                        stroke-opacity=".18" />
                {[0, 1, 2, 3].map((i) => (
                  <circle cx={49 + i * 55} cy="140" r="12"
                          fill={i === 0 ? 'var(--signal-solid)' : 'var(--line)'} />
                ))}
                <rect x="258" y="14" width="66" height="70" rx="10"
                      fill="var(--well)" stroke="var(--line)" />
                <rect x="258" y="92" width="66" height="70" rx="10"
                      fill="var(--well)" stroke="var(--line)" />
              </svg>
            )}
            { c.size === 'wide' && (
              <svg class="bcard__art bcard__art--keys" viewBox="0 0 300 84" aria-hidden="true">
                {['⌘', '⌃', '⌥', '⇧'].map((k, i) => (
                  <g transform={`translate(${8 + i * 74} 8)`}>
                    <rect width="64" height="60" rx="12"
                          fill={i === 0 ? 'var(--signal-haze)' : 'var(--well)'}
                          stroke={i === 0 ? 'var(--signal-edge)' : 'var(--line)'} />
                    <text x="32" y="40" text-anchor="middle" font-size="26"
                          font-weight="600" font-family="var(--body)"
                          fill={i === 0 ? 'var(--signal-ink)' : 'var(--text-dim)'}>{k}</text>
                  </g>
                ))}
              </svg>
            )}
            { (!c.size || c.size === 'full') && (
              <span class="bcard__g" aria-hidden="true"><Glyph name={c.g} size={22} /></span>
            )}
            <h3 class="bcard__t">{c.t}</h3>
            <p class="bcard__d">{c.d}</p>
          </li>
        ))}
      </ul>

      <p class="caps__not reveal">
        <strong>And what it isn’t.</strong> ReMoKey sends input, not video. There
        is no screen mirroring and nothing to watch — you look at the Mac’s own
        display, the way you would with any keyboard.
      </p>
    </div>
  </section>

  <!-- ═══ PRIVACY ═══ -->
  <section class="priv" aria-labelledby="priv-h">
    <div class="wrap priv__in">
      <div class="priv__copy reveal">
        <p class="label">Where it goes</p>
        <h2 class="t-xl" id="priv-h">Nowhere.<br />That’s the feature.</h2>
        <p class="lede">
          There is no ReMoKey server for your input to pass through, because
          there is nothing for one to do. Your keystrokes go from your iPhone to
          your Mac and stop.
        </p>
        <ul class="priv__list" role="list">
          <li><strong>No account, no sign-in, no subscription.</strong> Nothing to breach.</li>
          <li><strong>Encrypted, phone to Mac.</strong> The connection is authenticated by the key minted when you paired, held in your iPhone’s Keychain.</li>
          <li><strong>No analytics, no telemetry.</strong> Not reduced — absent.</li>
          <li><strong>One outbound request, and you can read it.</strong> The Mac app fetches its update file once a day. That is the only thing either app contacts besides the other.</li>
          <li><strong>Dictation never leaves the phone.</strong> If your language has no on-device model, dictation simply doesn’t run.</li>
        </ul>
        <p>
          <a href="/privacy/">Read the privacy policy</a> — it is short, because
          there is little to say.
        </p>
      </div>

      <!-- The diagram states the section's claim: the signal crosses your
           Wi-Fi and stops at the Mac. The internet is drawn — because leaving
           it out would dodge the question — and nothing reaches it. -->
      <div class="priv__art reveal" style="--reveal-delay:120ms" aria-hidden="true">
        <svg viewBox="0 0 560 420" class="priv__svg" aria-hidden="true">
          <!-- Your network: the boundary everything happens inside -->
          <rect x="22" y="46" width="356" height="340" rx="44"
                fill="var(--signal-haze)" stroke="var(--line-lit)"
                stroke-dasharray="1 7" stroke-width="1.6" stroke-linecap="round" />
          <text x="52" y="32" class="priv__cap">Your Wi-Fi</text>

          <!-- The iPhone -->
          <g transform="translate(72 236)">
            <rect x="0" y="0" width="62" height="122" rx="13" fill="var(--card)"
                  stroke="var(--line-lit)" stroke-width="1.5" />
            <rect x="19" y="8" width="24" height="7" rx="3.5" fill="var(--line-lit)" />
            <rect x="8" y="24" width="46" height="76" rx="6" fill="var(--well)" />
            <rect x="22" y="110" width="18" height="3.5" rx="1.75" fill="var(--line-lit)" />
          </g>

          <!-- The Mac -->
          <g transform="translate(196 128)">
            <rect x="0" y="0" width="150" height="96" rx="8" fill="var(--card)"
                  stroke="var(--line-lit)" stroke-width="1.5" />
            <rect x="7" y="7" width="136" height="82" rx="4" fill="var(--well)" />
            <rect x="7" y="7" width="136" height="9" rx="3" fill="var(--line)" />
            <path d="M 55 96 h 40 l 8 12 h -56 Z" fill="var(--line-lit)" />
          </g>

          <!-- The signal: phone to Mac, and no further. -->
          <path id="privPath" d="M 134 280 C 172 268, 178 216, 214 196" fill="none"
                stroke="var(--signal)" stroke-width="2.5" stroke-linecap="round" />
          <path d="M 206 202 l 9 -6.5 -11 -2.5" fill="none" stroke="var(--signal)"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle class="priv__pkt" cx="160" cy="248" r="4.5" fill="var(--signal)" />

          <!-- The internet, present and unreached. The gap between the
               boundary and the cloud is the whole argument. -->
          <g class="priv__net">
            <path d="M 447 118 a 26 26 0 0 1 25 -19 a 30 30 0 0 1 29 22 a 21 21 0 0 1 -4 41 h -64 a 22 22 0 0 1 -8 -43 z"
                  fill="none" stroke="var(--text-mute)" stroke-width="1.6"
                  stroke-dasharray="5 6" stroke-linecap="round" />
            <text x="424" y="196" class="priv__cap priv__cap--mute">The internet</text>
            <text x="424" y="216" class="priv__cap priv__cap--mute">— not involved</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ═══ CLOSE ═══ -->
  <section class="close" aria-labelledby="close-h">
    <div class="wrap close__in reveal">
      <h2 class="t-xl" id="close-h">Put it on both,<br />and forget it’s there.</h2>
      <p class="lede close__lede">
        The Mac app lives in the menu bar and updates itself. The iPhone app
        connects the moment you open it.
      </p>
      <StoreCta />
      <p class="close__req">
        macOS {MAC_MIN_OS} or later · iOS {IOS_MIN_OS} or later
      </p>
    </div>
  </section>
</Base>

<style>
  /* ───────── Hero ───────── */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.5rem + 7vw, 7rem) clamp(4rem, 2rem + 7vw, 8rem);
    overflow: hidden;
  }
  /* Atmosphere: dawn warmth where the phone opens, signal cool where it
     lands. The two glows sketch the journey before the phone makes it. */
  .hero__bg {
    position: absolute;
    inset: -20% -10% auto;
    height: 120%;
    background:
      radial-gradient(46% 40% at 80% 14%, var(--dawn), transparent 70%),
      radial-gradient(56% 46% at 24% 66%, var(--signal-haze), transparent 72%);
    pointer-events: none;
  }
  .hero__in { position: relative; }
  .nowrap { white-space: nowrap; }

  .hero__grid { display: grid; }
  .hero__h { margin-bottom: 1.5rem; max-width: 60rem; }
  .hero__lede { margin-bottom: 2rem; }

  /* The anchor only exists where the journey runs. */
  .hero__anchor { display: none; }

  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      align-items: center;
      gap: 2rem;
    }
    /* t-mega is sized for a full-width headline. Beside the phone column it
       wraps to four lines and shoves the CTA below the fold, so the hero
       carries its own cap while the grid is split. */
    .hero__h { font-size: clamp(3.2rem, 1.1rem + 4.9vw, 6rem); }
    .hero__anchor {
      display: block;
      width: min(100%, 15rem);
      aspect-ratio: 390 / 844;
      justify-self: center;
    }
  }

  .stage {
    position: relative;
    margin-top: clamp(3rem, 1.5rem + 6vw, 6rem);
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 2.5rem;
  }
  .stage__mac { position: relative; width: min(100%, 46rem); }
  .stage__macL--ready { position: absolute; inset: 0; opacity: 0; }
  .stage__macL { transition: opacity 0.5s var(--ease); }
  .stage__phone { position: relative; width: min(56%, 15rem); }

  /* The journey's swap: until the phone lands, the Mac is still waiting. */
  .hero.is-journey .stage__macL--ready { opacity: 1; }
  .hero.is-journey .stage__macL--connected { opacity: 0; }
  .hero.is-journey.is-landed .stage__macL--ready { opacity: 0; }
  .hero.is-journey.is-landed .stage__macL--connected { opacity: 1; }

  /* The traveller. Layout position is the landing position; the opening pose
     is pure transform, driven by three measured vars and one progress var.
     --jp runs 1 (beside the headline) → 0 (landed), already eased by the
     engine so the flight settles rather than stops. */
  .stage__phoneIn {
    transform:
      translate(calc(var(--jdx, 0px) * var(--jp, 0)),
                calc(var(--jdy, 0px) * var(--jp, 0)))
      rotate(calc(var(--jp, 0) * 6deg))
      scale(calc(1 + (var(--jsw, 1) - 1) * var(--jp, 0)));
    will-change: transform;
  }

  /* Side by side and overlapping, only when there is genuinely room. */
  @media (min-width: 62rem) {
    .stage {
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
      justify-items: stretch;
      gap: 0;
    }
    /* Explicit rows on both. The Mac comes first in the DOM so the phone is
       not announced before the thing it controls, and auto-placement will not
       walk backwards into an earlier column — without a row the phone lands on
       row 2 and the two devices stack.
       The columns deliberately overlap: the phone standing in front of the
       Mac says "these two are a pair" far more directly than a gap and a line
       between them, and it cannot fall out of alignment. */
    .stage__mac   { grid-column: 4 / -1; grid-row: 1; width: 100%; align-self: start; }
    .stage__phone {
      grid-column: 1 / 5;
      grid-row: 1;
      /* Bottom-aligned and overlapping the Mac's lower-left. The phone is
         taller than the Mac's screen and hangs a little below its base, which
         is what makes it read as standing in front rather than sitting inside
         the composition. */
      width: min(100%, 13.5rem);
      justify-self: end;
      align-self: end;
      z-index: 2;
    }
  }

  /* ───────── Walkthrough ───────── */
  .walk { padding-block: clamp(4rem, 2rem + 7vw, 9rem) 0; }
  .walk__head { max-width: 44rem; margin-bottom: clamp(2rem, 1rem + 4vw, 4rem); }

  .walk__grid { display: grid; gap: 2rem; }

  .walk__stick { display: none; }

  /* role="list" is on the element itself: Safari drops the list role, and with
     it the item count, as soon as list-style is none. */
  .walk__steps { list-style: none; margin: 0; padding: 0; }

  .step {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-top: 1px solid var(--line);
    max-width: 38rem;
  }
  .step:first-child { border-top: 0; }
  .step h3 { margin-bottom: 0.9rem; }

  /* How the current step is marked, now that opacity is off the table: the
     hairline before its label grows and picks up the signal colour. */
  .step .label::before {
    transition: width 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  .step.is-current .label::before { width: 3.2rem; background: var(--signal-solid); }
  .step.is-current .label { color: var(--text-dim); }
  .step p { color: var(--text-dim); }
  .step__aside {
    margin-top: 1.1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--line-lit);
    font-size: var(--t-sm);
    color: var(--text-mute);
  }

  /* Narrow screens get the art inline, one device per step, because the sticky
     column is display:none below 64rem — without this the walkthrough was three
     blocks of prose and no picture, on a site about a phone app, viewed mostly
     on a phone. Only the phone is shown: the Mac's HUD text is unreadable at
     this width, and a device you cannot read is decoration. */
  .step__art { width: min(58%, 13rem); margin: 0 0 1.75rem; }

  @media (min-width: 64rem) {
    .walk__grid {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
      gap: clamp(1.5rem, -1rem + 4vw, 3.5rem);
      align-items: start;
    }

    .walk__stick {
      display: block;
      position: sticky;
      top: 0;
      height: 100vh;
      /* svh keeps the stage inside the visible area on iOS, where the URL bar
         makes 100vh taller than the screen actually is. */
      height: 100svh;
      display: grid;
      align-content: center;
      gap: 1.25rem;
      padding-block: 4rem;
    }

    .walk__devices, .walk__mac { position: relative; }
    .walk__devices { width: min(38%, 12rem); margin-inline: auto; }
    .walk__mac { width: min(100%, 35rem); margin-inline: auto; }

    .walk__layer {
      transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    }
    /* Layers after the first are stacked on top of the first, which alone
       holds the box's height. */
    .walk__layer:not([data-layer='0']):not([data-maclayer='0']) {
      position: absolute;
      inset: 0;
    }
    .walk__layer:not(.is-on) { opacity: 0; transform: scale(0.985); }
    .walk__layer.is-on { opacity: 1; transform: none; }

    /* Exactly one viewport per step, and this is load-bearing rather than a
       round number. A sticky element of height H inside a track of N steps of
       height S stays pinned for N·S − H, but step N is centred at (N−0.5)·S.
       Pinning must therefore last until (N−0.5)·S, which needs S ≥ 2H. With
       H = 100svh that is satisfied only when S = 100svh and the last step's
       centre coincides with the final pinned frame. At the 78vh this used to
       be, the device column unstuck partway through step 2 and step 3 was
       delivered against an empty column. */
    .step__art { display: none; }

    .step {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-top: 0;
      /* No opacity dimming. It started at 0.4, which put the body text at
         2.13:1 — and the alpha that WOULD clear 4.5:1 for the aside's
         --text-mute is 0.90, at which point the dimming is invisible and buys
         nothing. Marking the current step is a job for a mark, not for
         degrading the legibility of the other two. */
      transition: none;
    }
    /* A little runway so the last step is not flush against the section end. */
    .walk__steps { padding-bottom: 5svh; }
  }

  /* Without JS nothing ever gets `.is-current`, so dimming would leave every
     step dimmed permanently — and it is the whole page's content. */
  :global(html:not(.js)) .step { opacity: 1; }

  /* With no JS the anchor is empty air reserving a grid column — collapse it
     and let the headline breathe across the full width. */
  :global(html:not(.js)) .hero__anchor { display: none; }
  @media (min-width: 62rem) {
    :global(html:not(.js)) .hero__grid { grid-template-columns: 1fr; }
  }

  /* Reduced motion takes the same route as no-JS, for the same reason: the
     engine that advances the sticky column never runs, so the column would sit
     on step 1's art for all three steps — a Mac saying "Ready to pair" next to
     the paragraph about using the trackpad. The inline art cannot be wrong,
     because each copy belongs to its own step. The hero journey never starts
     either: the phone stands landed beside its Mac, which is the finished
     state, and the anchor collapses.

     KEEP `.walk__stick`, `.step__art` and `.step` in this block — the a11y
     suite pins them. */
  @media (prefers-reduced-motion: reduce) {
    .walk__stick { display: none !important; }
    .step__art { display: block !important; width: min(48%, 12rem); }
    .step { min-height: 0 !important; }
    .hero__anchor { display: none !important; }
    .hero__grid { grid-template-columns: 1fr !important; }
    .stage__phoneIn { transform: none !important; }
  }

  /* With no JS every layer is visible, and stacking them would be a pile of
     overlapping phones. Show only the first and let the prose carry it. */
  :global(html:not(.js)) .walk__layer:not(.is-on) { display: none; }

  /* ───────── Capabilities (bento) ───────── */
  .caps { padding-block: clamp(2.5rem, 1rem + 4vw, 5rem) clamp(4rem, 2rem + 7vw, 9rem); }
  .caps__head { max-width: 44rem; margin-bottom: clamp(2rem, 1rem + 4vw, 3.5rem); }

  .bento {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  /* The spans are chosen so every row of the grid is full at every breakpoint
     — a bento with a hole in it reads as a bug, not a layout. 2-col: 2+2,
     then six singles, then the full-width closer. 6-col: 4+2, then two rows
     of three, then the closer. */
  @media (min-width: 38rem) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .bcard--feature, .bcard--wide, .bcard--full { grid-column: span 2; }
  }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .bcard { grid-column: span 2; }
    .bcard--feature { grid-column: span 4; }
    .bcard--wide { grid-column: span 2; }
    .bcard--full { grid-column: 1 / -1; }
  }

  /* The keyboard card shares a row with the tall feature card; centring its
     art in the slack keeps it composed instead of top-heavy. */
  .bcard--wide { display: flex; flex-direction: column; }
  .bcard--wide .bcard__art--keys { margin-block: auto; }

  /* The closer reads sideways: chip, then copy. */
  @media (min-width: 38rem) {
    .bcard--full {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1.25rem;
      align-items: start;
    }
    .bcard--full .bcard__g { margin-bottom: 0; grid-row: 1 / 3; }
    .bcard--full .bcard__d { max-width: 46rem; }
  }

  .bcard {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.4rem, 1rem + 1.2vw, 2rem);
    box-shadow: var(--shadow-card);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .bcard:hover { transform: translateY(-2px); border-color: var(--line-lit); }

  .bcard__art {
    width: 100%;
    height: auto;
    margin-bottom: 1.1rem;
  }
  .bcard__art--keys { max-width: 19rem; }

  .bcard__g {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 11px;
    background: var(--signal-haze);
    color: var(--signal-ink);
    margin-bottom: 1rem;
  }
  .bcard__t {
    font-size: var(--t-md);
    letter-spacing: -0.02em;
    margin-bottom: 0.45rem;
  }
  .bcard__d { color: var(--text-dim); font-size: var(--t-sm); margin: 0; }

  .caps__not {
    color: var(--text-mute);
    font-size: var(--t-sm);
    max-width: 46rem;
  }
  .caps__not strong { color: var(--text-dim); }

  /* ───────── Privacy ───────── */
  .priv {
    padding-block: clamp(4rem, 2rem + 7vw, 9rem);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(60% 50% at 78% 40%, var(--signal-haze), transparent 70%);
  }
  .priv__in { display: grid; gap: clamp(2.5rem, 1rem + 5vw, 4rem); align-items: center; }
  @media (min-width: 60rem) {
    .priv__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  }
  .priv__copy h2 { margin-bottom: 1.25rem; }
  .priv__copy .lede { margin-bottom: 1.75rem; }
  .priv__list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .priv__list li {
    color: var(--text-dim);
    font-size: var(--t-sm);
    padding-left: 1.6rem;
    position: relative;
  }
  .priv__list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.55em;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--signal-solid);
  }
  .priv__list strong { color: var(--text); font-weight: 600; }

  .priv__svg { width: 100%; height: auto; max-width: 30rem; margin-inline: auto; }
  .priv__cap {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--text-dim);
  }
  .priv__cap--mute { fill: var(--text-mute); letter-spacing: 0.1em; text-transform: none; }

  /* The packet rides the signal path on a loop. Browsers without offset-path
     leave the circle at its cx/cy, which sits on the path — a still frame of
     the same story. The global reduced-motion rule freezes it the same way. */
  .priv__pkt {
    offset-path: path('M 134 280 C 172 268, 178 216, 214 196');
    offset-rotate: 0deg;
    animation: pkt-travel 2.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }
  @supports (offset-path: path('M 0 0 L 1 1')) {
    .priv__pkt { cx: 0; cy: 0; }
  }
  @keyframes pkt-travel {
    0% { offset-distance: 0%; opacity: 0; }
    12% { opacity: 1; }
    82% { opacity: 1; }
    96% { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* ───────── Close ───────── */
  .close {
    padding-block: clamp(4rem, 2rem + 7vw, 9rem);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .close__in { display: grid; justify-items: center; gap: 1.5rem; }
  .close__lede { margin: 0; }
  .close__req {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--text-mute);
    margin: 0;
  }
</style>

<script>
  /* ═════ The whole motion layer ═════
     Two observers and one rAF-coalesced scroll handler. No dependencies.

     Bails out entirely under prefers-reduced-motion: the listeners are never
     attached and every element is left in its finished state, so the page is a
     static document rather than a fast version of the same animation. */

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  /* Disarms the CSS failsafe in global.css. Called only once the mechanism that
     reveals content is genuinely in place, so a module that throws on the way
     there still gets the fallback. */
  const armed = () => document.documentElement.classList.add('js-live');

  const revealAll = () =>
    document.querySelectorAll('.reveal').forEach((n) => n.classList.add('is-in'));

  /* Every listener and observer this function installs is tied to one
     AbortController, so a preference change can tear the whole engine down
     rather than layering a second copy on top of the first. */
  let live = null;

  function stop() {
    live?.abort();
    live = null;
  }

  function start() {
    stop();
    if (reduced.matches) {
      revealAll();
      armed();
      return;
    }
    live = new AbortController();
    const { signal } = live;

    /* 1 — Reveals. Unobserved once shown; nothing re-hides on scroll up. */
    const revealIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          revealIO.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    document.querySelectorAll('.reveal').forEach((n) => revealIO.observe(n));
    signal.addEventListener('abort', () => revealIO.disconnect(), { once: true });
    armed();

    /* 2 — Walkthrough. The step whose midpoint is nearest the middle of the
       viewport wins, which is stable while scrolling in either direction —
       "last one to intersect" is not. */
    const steps = [...document.querySelectorAll('.step')];
    const layers = [...document.querySelectorAll('[data-layer]')];
    const macLayers = [...document.querySelectorAll('[data-maclayer]')];
    let currentStep = -1;

    function syncSteps() {
      if (!steps.length) return;
      const mid = innerHeight / 2;
      let best = 0, bestDist = Infinity;
      for (let i = 0; i < steps.length; i++) {
        const r = steps[i].getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      }
      if (best === currentStep) return;
      currentStep = best;
      steps.forEach((s, i) => s.classList.toggle('is-current', i === best));
      layers.forEach((l) => l.classList.toggle('is-on', +l.dataset.layer === best));
      macLayers.forEach((l) => l.classList.toggle('is-on', +l.dataset.maclayer === best));
    }

    /* 3 — The hero journey. The phone opens beside the headline and lands in
       front of the Mac; both poses are measured, so the flight follows the
       real layout at every viewport rather than a hand-tuned guess. The
       opening pose is a transform away from the LANDED layout position, which
       is why nothing here has to run for the finished state to be correct. */
    const hero = document.querySelector('[data-hero]');
    const jSlot = document.querySelector('[data-journey-slot]');
    const jPhone = document.querySelector('[data-journey-phone]');
    const jAnchor = document.querySelector('[data-journey-anchor]');
    const wide = matchMedia('(min-width: 62rem)');
    let jEndY = 0;

    function measureJourney() {
      if (!hero || !jSlot || !jPhone || !jAnchor) return;
      if (!wide.matches) {
        hero.classList.remove('is-journey');
        jPhone.style.setProperty('--jp', '0');
        return;
      }
      hero.classList.add('is-journey');
      /* Same-document rects taken in the same frame: the scroll offset
         cancels out of the deltas. */
      const a = jAnchor.getBoundingClientRect();
      const s = jSlot.getBoundingClientRect();
      jPhone.style.setProperty('--jdx', `${(a.left + a.width / 2) - (s.left + s.width / 2)}px`);
      jPhone.style.setProperty('--jdy', `${(a.top + a.height / 2) - (s.top + s.height / 2)}px`);
      jPhone.style.setProperty('--jsw', (a.width / s.width).toFixed(4));
      /* The flight completes as the Mac reaches centre stage. */
      jEndY = Math.max(1, scrollY + s.top + s.height / 2 - innerHeight / 2);
    }

    function syncJourney() {
      if (!hero || !jPhone || !wide.matches) return;
      const p = Math.min(1, Math.max(0, scrollY / jEndY));
      /* Eased here rather than in CSS so the transform is one multiplication:
         (1-p)² keeps full speed leaving the headline and settles into the
         landing instead of stopping dead. */
      jPhone.style.setProperty('--jp', ((1 - p) * (1 - p)).toFixed(4));
      hero.classList.toggle('is-landed', p > 0.72);
    }

    /* 4 — Header hairline. */
    const root = document.documentElement;
    function syncHeader() {
      root.classList.toggle('is-stuck', scrollY > 8);
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        syncSteps();
        syncJourney();
        syncHeader();
        ticking = false;
      });
    }

    function onResize() {
      measureJourney();
      onScroll();
    }

    addEventListener('scroll', onScroll, { passive: true, signal });
    addEventListener('resize', onResize, { passive: true, signal });
    measureJourney();
    onScroll();
  }

  start();
  /* Someone can change the preference mid-visit. start() tears the previous
     engine down first, so toggling never accumulates listeners, and both
     branches only ever ADD `.is-in` — nothing here can re-hide content that has
     already been revealed. */
  reduced.addEventListener?.('change', start);
</script>
