---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PRODUCT_NAME, SITE_URL } from '../config.mjs';
import '../styles/global.css';

const { title, description, frontmatter, wide = false } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? PRODUCT_NAME;
const pageDesc = description ?? frontmatter?.description ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const ogImage = new URL('/og.png', Astro.site ?? SITE_URL);

// Markdown pages arrive with a `frontmatter` prop; .astro pages do not. That is
// exactly the "is this a document rather than a marketing surface?" distinction
// the .doc styles want, so it drives them rather than a hand-set flag that a
// new page would forget.
const isDoc = !!frontmatter;

// Must match --bg in global.css for each theme; the inline theme script and the
// header toggle both keep the meta tag in step so the browser chrome follows.
const THEME_COLOR = { light: '#f4f1e9', dark: '#111214' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    <link rel="canonical" href={canonical} />

    <!-- Paints the browser chrome to match the canvas on iOS and Android, so
         the page does not sit in a mismatched frame on the devices it is
         about. The inline script below corrects it before first paint when the
         stored theme is dark. -->
    <meta name="theme-color" content={THEME_COLOR.light} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={pageTitle} />
    {pageDesc && <meta property="og:description" content={pageDesc} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- The display face is the only render-blocking asset on the page.
         Preloading it alongside the stylesheet stops the headline reflowing
         after first paint. -->
    <link rel="preload" href="/fonts/bricolage-grotesque-display.woff2"
          as="font" type="font/woff2" crossorigin />

    <!-- Marks scripting as available BEFORE first paint, so the reveal
         animations may start hidden. Without this the CSS would have to
         default to hidden, and a scripting-disabled browser would get a blank
         page — precisely the failure this class exists to prevent.

         The same script applies the stored theme. It must run inline in
         <head>: applied any later, a dark-theme visitor gets a flash of light
         page on every navigation. The DEFAULT is light for everyone — the
         system preference is deliberately not consulted, so the only way to
         get dark is to have chosen it. -->
    <script is:inline define:vars={{ THEME_COLOR }}>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('rk-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', THEME_COLOR.dark);
        }
      } catch {
        /* Storage can be denied (private mode, cookie blocking). The site is
           simply light, which is the default anyway. */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <!-- tabindex="-1" so the skip link actually MOVES focus rather than only
         scrolling: Chrome's sequential-focus-start papers over the difference,
         VoiceOver's reading cursor does not. scroll-margin-top keeps the
         landing point clear of the sticky header. -->
    <main id="main" tabindex="-1" class={wide ? '' : `wrap wrap--text${isDoc ? ' doc' : ''}`}><slot /></main>
    <Footer />
  </body>
</html>
