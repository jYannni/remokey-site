---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PRODUCT_NAME, SITE_URL } from '../config.mjs';
import '../styles/global.css';

const { title, description, frontmatter, wide = false } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? PRODUCT_NAME;
const pageDesc = description ?? frontmatter?.description ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const ogImage = new URL('/og.png', Astro.site ?? SITE_URL);

// Markdown pages arrive with a `frontmatter` prop; .astro pages do not. That is
// exactly the "is this a document rather than a marketing surface?" distinction
// the .doc styles want, so it drives them rather than a hand-set flag that a
// new page would forget.
const isDoc = !!frontmatter;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    <link rel="canonical" href={canonical} />

    <!-- Paints the browser chrome to match the canvas on iOS and Android, so
         the page does not sit in a white frame on the devices it is about. -->
    <meta name="theme-color" content="#08090c" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={pageTitle} />
    {pageDesc && <meta property="og:description" content={pageDesc} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- The display face is the only render-blocking asset on the page.
         Preloading it alongside the stylesheet stops the headline reflowing
         after first paint. -->
    <link rel="preload" href="/fonts/bricolage-grotesque-display.woff2"
          as="font" type="font/woff2" crossorigin />

    <!-- Marks scripting as available BEFORE first paint, so the reveal
         animations may start hidden. Without this the CSS would have to
         default to hidden, and a scripting-disabled browser would get a blank
         page — precisely the failure this class exists to prevent. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={wide ? '' : `wrap wrap--text${isDoc ? ' doc' : ''}`}><slot /></main>
    <Footer />
  </body>
</html>
