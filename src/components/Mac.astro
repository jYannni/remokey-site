---
/**
 * A MacBook rendering the real ReMoKey host UI: the menu-bar mark and the
 * notch HUD card — on a desktop that looks like a Mac's, not a placeholder's.
 *
 * The realism is the point. The menu bar carries the Apple mark, Finder's
 * actual menu titles and the status items a Mac really shows; the Dock holds
 * recognisable (hand-drawn, not Apple's artwork) app icons; the wallpaper is
 * a macOS-style aurora. Every Apple-drawn asset is approximated from scratch —
 * nothing is traced or redistributed, and the footer already states the site
 * is not affiliated with Apple.
 *
 * The ReMoKey menu-bar mark is redrawn from the deterministic geometry in the
 * app's own icon generator (Scripts/make-app-icons.swift, drawMenuGlyph) — a
 * key cap with Wi-Fi waves rising out of it. It is template-rendered in macOS,
 * which means it takes the menu bar's foreground colour: near-black on this
 * light menu bar, exactly as it would on a real desktop with this wallpaper.
 *
 * The HUD silhouette (NotchCardShape.swift) is the distinctive part: concave
 * fillets at the top that flare outward so the screen edge curves *into* the
 * card's sides, and ordinary 18pt rounded corners at the bottom. It reads as
 * dropping out from behind the notch rather than floating.
 *
 * hud: 'none' | 'connecting' | 'connected' | 'code' | 'ready'
 * waves: 0-3, how many waves the menu-bar mark shows
 */
const { hud = 'none', waves = 3, label, klass = '' } = Astro.props;

// A per-instance suffix for the <defs> ids. The landing page renders hud
// "connected" twice — hero and walkthrough — and two elements sharing
// id="wall-connected" means every url(#wall-connected) in the document
// resolves to the FIRST, so the second Mac was painted with the first one's
// gradients and clipped by its clip path.
globalThis.__rkMacSeq = (globalThis.__rkMacSeq ?? 0) + 1;
const uid = `mc${globalThis.__rkMacSeq}`;

const VB_W = 1640, VB_H = 1120;
const SCR_X = 62, SCR_Y = 26, SCR_W = 1516, SCR_H = 968;
const MENU_H = 38;
const NOTCH_W = 216, NOTCH_H = 34;

// The menu bar's foreground. macOS derives it from the wallpaper; over this
// one it is dark, and every status item and the ReMoKey mark inherit it.
const MB_FG = '#1c1d22';

// Silhouette from NotchCardShape.swift; the 300pt width and the per-card
// heights are in NotchHUDContent.swift. Top concave fillet 12, bottom radius 18.
// Drawn at 1.9x so it reads at the scale the Mac is shown on the page.
const K = 1.9;
const CARD_W = 300 * K;
const CARD_H = { connecting: 96, connected: 96, ready: 150, code: 226, none: 0 }[hud] * K;
const RC = 12 * K, RB = 18 * K;
const CARD_X = SCR_X + SCR_W / 2 - CARD_W / 2;

const cardPath = (W, H, rc, rb) => [
  `M ${-rc} 0`, `A ${rc} ${rc} 0 0 1 0 ${rc}`,
  `L 0 ${H - rb}`, `A ${rb} ${rb} 0 0 0 ${rb} ${H}`,
  `L ${W - rb} ${H}`, `A ${rb} ${rb} 0 0 0 ${W} ${H - rb}`,
  `L ${W} ${rc}`, `A ${rc} ${rc} 0 0 1 ${W + rc} 0`, 'Z',
].join(' ');

// Menu titles, Finder frontmost. Real text, not pills — pills were the single
// loudest "this is not a Mac" tell in the first draft.
const MENUS = [
  { t: 'Finder', x: 64, w: 600 },
  { t: 'File', x: 136 }, { t: 'Edit', x: 186 }, { t: 'View', x: 238 },
  { t: 'Go', x: 296 }, { t: 'Window', x: 340 }, { t: 'Help', x: 424 },
];

// Dock: eight hand-drawn stand-ins at 54pt, the size a real Dock defaults to.
const DOCK_N = 8, DOCK_S = 54, DOCK_GAP = 14, DOCK_PAD = 16;
const DOCK_W = DOCK_N * DOCK_S + (DOCK_N - 1) * DOCK_GAP + DOCK_PAD * 2;
const DOCK_H = DOCK_S + 20;
const DOCK_X = SCR_X + (SCR_W - DOCK_W) / 2;
const DOCK_Y = SCR_Y + SCR_H - DOCK_H - 12;
const dockX = (i) => DOCK_X + DOCK_PAD + i * (DOCK_S + DOCK_GAP);

const alt = label ?? {
  none: 'A MacBook with the ReMoKey mark in its menu bar',
  connecting: 'A MacBook showing a Connecting notification below the notch',
  connected: 'A MacBook showing a Connected notification below the notch',
  ready: 'A MacBook waiting for an iPhone to pair',
  code: 'A MacBook showing a four-digit pairing code with a Confirm button',
}[hud];

const DEVICE = 'Yanko’s iPhone';
---

<div class={`mac ${klass}`}>
  <svg viewBox={`0 0 ${VB_W} ${VB_H}`} role="img" aria-label={alt} class="mac__svg">
    <defs>
      <!-- Silver chassis, not graphite: it is what a MacBook is made of. -->
      <linearGradient id={`lid-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#eceef2" /><stop offset="1" stop-color="#b7bcc6" />
      </linearGradient>
      <linearGradient id={`base-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e7e9ee" />
        <stop offset=".55" stop-color="#b4bac4" />
        <stop offset="1" stop-color="#878e9a" />
      </linearGradient>

      <!-- Wallpaper: a macOS-style aurora. Base sweep plus two soft glows —
           radial gradients, not filters, so six device renders stay cheap. -->
      <linearGradient id={`wall-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#141c52" />
        <stop offset=".34" stop-color="#3b2e92" />
        <stop offset=".62" stop-color="#8f4198" />
        <stop offset=".85" stop-color="#d05f77" />
        <stop offset="1" stop-color="#ec8a5c" />
      </linearGradient>
      <radialGradient id={`glowa-${uid}`} cx="24%" cy="18%" r="55%">
        <stop offset="0" stop-color="#54c8ff" stop-opacity=".5" />
        <stop offset="1" stop-color="#54c8ff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`glowb-${uid}`} cx="78%" cy="84%" r="60%">
        <stop offset="0" stop-color="#ffb36b" stop-opacity=".55" />
        <stop offset="1" stop-color="#ffb36b" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`sheen-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity=".09" />
        <stop offset=".38" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>

      <!-- Dock icon gradients -->
      <linearGradient id={`ic-finder-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#57b6f5" /><stop offset="1" stop-color="#1a7ade" />
      </linearGradient>
      <linearGradient id={`ic-msg-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6ee55c" /><stop offset="1" stop-color="#27b53c" />
      </linearGradient>
      <linearGradient id={`ic-mail-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4ba3f5" /><stop offset="1" stop-color="#1668d2" />
      </linearGradient>
      <linearGradient id={`ic-music-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fc6076" /><stop offset="1" stop-color="#e2334f" />
      </linearGradient>
      <linearGradient id={`ic-set-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9aa0ab" /><stop offset="1" stop-color="#5d636d" />
      </linearGradient>

      <clipPath id={`scrclip-${uid}`}>
        <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={SCR_H} rx="12" />
      </clipPath>
    </defs>

    <!-- Lid -->
    <rect x="40" y="0" width={VB_W - 80} height={SCR_H + 52} rx="26" fill={`url(#lid-${uid})`} />
    <rect x="52" y="14" width={VB_W - 104} height={SCR_H + 26} rx="18" fill="#0a0c10" />

    <g clip-path={`url(#scrclip-${uid})`}>
      <!-- Desktop -->
      <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={SCR_H} fill={`url(#wall-${uid})`} />
      <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={SCR_H} fill={`url(#glowa-${uid})`} />
      <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={SCR_H} fill={`url(#glowb-${uid})`} />

      <!-- Menu bar: translucent over the wallpaper, dark foreground -->
      <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={MENU_H} fill="rgba(250,250,252,0.68)" />

      <g fill={MB_FG}>
        <!-- The Apple mark, approximated freehand -->
        <g transform={`translate(${SCR_X + 26} ${SCR_Y + 10.5}) scale(0.9)`}>
          <path d="M12.4 0c.1 1.1-.3 2.2-1 3-.7.8-1.8 1.4-2.9 1.3-.1-1 .4-2.1 1-2.8.7-.8 1.9-1.4 2.9-1.5Z" />
          <path d="M16.7 14.6c-.4 1-.6 1.4-1.2 2.3-.8 1.2-1.9 2.8-3.3 2.8-1.2 0-1.6-.8-3.2-.8-1.6 0-2 .8-3.2.8-1.4 0-2.4-1.4-3.2-2.6C.4 13.8-.2 10.5.9 8.7 1.7 7.4 3 6.6 4.4 6.6c1.3 0 2.1.8 3.2.8 1 0 1.7-.8 3.2-.8 1.2 0 2.5.7 3.4 1.8-3 1.6-2.5 5.9.5 6.2Z" />
        </g>
        {MENUS.map((m) => (
          <text x={SCR_X + m.x} y={SCR_Y + 25} font-family="var(--body)"
                font-size="15" font-weight={m.w ?? 400} fill={MB_FG}>{m.t}</text>
        ))}
      </g>

      <!-- Status items, right to left: clock, Control Center, Wi-Fi, battery,
           and the ReMoKey mark among them where the app really puts it. -->
      <g fill={MB_FG} stroke="none">
        <text x={SCR_X + SCR_W - 26} y={SCR_Y + 25} text-anchor="end"
              font-family="var(--body)" font-size="15" fill={MB_FG}>Sat 16 Aug&#8194;21:42</text>

        <!-- Control Center: the two-pill switchboard -->
        <g transform={`translate(${SCR_X + SCR_W - 202} ${SCR_Y + 11})`} fill="none"
           stroke={MB_FG} stroke-width="1.6">
          <rect x="0" y="0" width="17" height="7.2" rx="3.6" />
          <circle cx="4.4" cy="3.6" r="1.5" fill={MB_FG} stroke="none" />
          <rect x="0" y="9.4" width="17" height="7.2" rx="3.6" />
          <circle cx="12.6" cy="13" r="1.5" fill={MB_FG} stroke="none" />
        </g>

        <!-- Wi-Fi -->
        <g transform={`translate(${SCR_X + SCR_W - 244} ${SCR_Y + 11})`} fill="none"
           stroke={MB_FG} stroke-width="1.9" stroke-linecap="round">
          <path d="M1 5.4a12.4 12.4 0 0 1 16 0M4 8.9a7.9 7.9 0 0 1 10 0M7 12.4a3.6 3.6 0 0 1 4 0" />
          <circle cx="9" cy="15" r="1.4" fill={MB_FG} stroke="none" />
        </g>

        <!-- Battery -->
        <g transform={`translate(${SCR_X + SCR_W - 298} ${SCR_Y + 12})`}>
          <rect x="0" y="0" width="30" height="14" rx="4" fill="none" stroke={MB_FG}
                stroke-opacity=".5" stroke-width="1.4" />
          <rect x="2.4" y="2.4" width="19" height="9.2" rx="2.2" fill={MB_FG} />
          <path d="M32 4.6v4.8a2.6 2.6 0 0 1 0-4.8Z" fill={MB_FG} fill-opacity=".5" />
        </g>

        <!-- The ReMoKey menu-bar mark. Template-rendered in macOS, so it takes
             the menu bar's own foreground colour — dark here, never the blue
             app icon. -->
        <g transform={`translate(${SCR_X + SCR_W - 352} ${SCR_Y + 5}) scale(28)`}
           fill="none" stroke={MB_FG} stroke-linecap="round">
          <g stroke-width="0.05">
            {waves >= 1 && <path d="M 0.375 0.483 A 0.125 0.125 0 0 1 0.625 0.483" />}
            {waves >= 2 && <path d="M 0.292 0.483 A 0.208 0.208 0 0 1 0.708 0.483" />}
            {waves >= 3 && <path d="M 0.208 0.483 A 0.292 0.292 0 0 1 0.792 0.483" />}
          </g>
          <circle cx="0.5" cy="0.483" r="0.022" fill={MB_FG} stroke="none" />
          <rect x="0.35" y="0.492" width="0.3" height="0.267" rx="0.067"
                fill={MB_FG} stroke="none" />
        </g>
      </g>

      <!-- Dock -->
      <g>
        <rect x={DOCK_X} y={DOCK_Y} width={DOCK_W} height={DOCK_H} rx="20"
              fill="rgba(250,250,252,0.42)" stroke="rgba(255,255,255,0.35)" stroke-width="1" />

        <!-- Finder -->
        <g transform={`translate(${dockX(0)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill={`url(#ic-finder-${uid})`} />
          <path d={`M ${DOCK_S * 0.54} 0 H 12 A 12 12 0 0 0 0 12 V ${DOCK_S - 12} A 12 12 0 0 0 12 ${DOCK_S} H ${DOCK_S * 0.54} Z`}
                fill="#dceefb" opacity=".9" />
          <g stroke="#0f4f9e" stroke-width="2.6" stroke-linecap="round" fill="none">
            <path d={`M ${DOCK_S * 0.3} 18 v 8 M ${DOCK_S * 0.66} 18 v 8`} />
            <path d={`M ${DOCK_S * 0.24} 37 q ${DOCK_S * 0.24} 9 ${DOCK_S * 0.5} 0`} />
          </g>
          <circle cx={DOCK_S / 2} cy={DOCK_S + 15} r="2.2" fill="rgba(20,20,30,0.55)" />
        </g>

        <!-- Safari -->
        <g transform={`translate(${dockX(1)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill="#f4f7fb" />
          <circle cx={DOCK_S / 2} cy={DOCK_S / 2} r="21" fill="#3aa7f0" />
          <circle cx={DOCK_S / 2} cy={DOCK_S / 2} r="21" fill="none" stroke="#1c7cd6" stroke-width="1.4" />
          <path d={`M ${DOCK_S / 2 + 11} ${DOCK_S / 2 - 11} L ${DOCK_S / 2 + 2.5} ${DOCK_S / 2 - 2.5} L ${DOCK_S / 2 - 11} ${DOCK_S / 2 + 11} L ${DOCK_S / 2 - 2.5} ${DOCK_S / 2 + 2.5} Z`}
                fill="#ffffff" />
          <path d={`M ${DOCK_S / 2 + 11} ${DOCK_S / 2 - 11} L ${DOCK_S / 2 + 2.5} ${DOCK_S / 2 - 2.5} L ${DOCK_S / 2 - 2.5} ${DOCK_S / 2 + 2.5} Z`}
                fill="#f5424e" />
        </g>

        <!-- Messages -->
        <g transform={`translate(${dockX(2)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill={`url(#ic-msg-${uid})`} />
          <path d={`M ${DOCK_S / 2} 11 c -10.5 0 -19 7 -19 15.6 0 5.5 3.5 10.3 8.8 13 -.3 2.3 -1.6 4.6 -3.6 6.3 3.4 -.4 6.5 -1.8 8.7 -3.7 1.6 .4 3.4 .6 5.1 .6 10.5 0 19 -7 19 -15.6 S ${DOCK_S / 2 + 10.5} 11 ${DOCK_S / 2} 11 Z`}
                fill="#ffffff" transform={`translate(${-DOCK_S / 2 + 27} 0)`} />
        </g>

        <!-- Mail -->
        <g transform={`translate(${dockX(3)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill={`url(#ic-mail-${uid})`} />
          <rect x="9" y="15" width={DOCK_S - 18} height={DOCK_S - 30} rx="4" fill="#ffffff" />
          <path d={`M 10.5 17 L ${DOCK_S / 2} ${DOCK_S / 2 + 2} L ${DOCK_S - 10.5} 17`}
                fill="none" stroke="#1668d2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>

        <!-- Photos -->
        <g transform={`translate(${dockX(4)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill="#fbfbfd" />
          {['#f6bd4e', '#ef8b46', '#e75d55', '#d8508f', '#9058c9', '#5062d8', '#4a9ce4', '#54bda1']
            .map((c, i) => (
              <ellipse cx={DOCK_S / 2} cy={DOCK_S / 2 - 10.5} rx="5.4" ry="10.5" fill={c}
                       opacity="0.82"
                       transform={`rotate(${i * 45} ${DOCK_S / 2} ${DOCK_S / 2})`} />
            ))}
        </g>

        <!-- Notes -->
        <g transform={`translate(${dockX(5)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill="#ffffff" />
          <path d={`M 0 12 h ${DOCK_S} v -0 a 12 12 0 0 0 -12 -12 h ${-(DOCK_S - 24)} a 12 12 0 0 0 -12 12 Z`}
                fill="#f7c94b" transform="translate(0 0.2)" />
          <rect x="0" y="12" width={DOCK_S} height="1.6" fill="#e2b93a" />
          <g stroke="#c9cbd2" stroke-width="2.4" stroke-linecap="round">
            <path d={`M 10 24 h ${DOCK_S - 20} M 10 33 h ${DOCK_S - 20} M 10 42 h ${DOCK_S - 30}`} />
          </g>
        </g>

        <!-- Music -->
        <g transform={`translate(${dockX(6)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill={`url(#ic-music-${uid})`} />
          <g fill="#ffffff">
            <path d={`M ${DOCK_S * 0.62} 12 v 20.5 a 5.6 5.6 0 1 1 -2.6 -4.8 V 17 l -12.6 3 v 16.3 a 5.6 5.6 0 1 1 -2.6 -4.8 V 16.2 Z`} />
          </g>
        </g>

        <!-- System Settings -->
        <g transform={`translate(${dockX(7)} ${DOCK_Y + 10})`}>
          <rect width={DOCK_S} height={DOCK_S} rx="12" fill={`url(#ic-set-${uid})`} />
          <g transform={`translate(${DOCK_S / 2} ${DOCK_S / 2})`}>
            <path d="M -3.2 -16.4 h 6.4 l 1 3.7 2.8 1.6 3.6 -1.3 3.2 5.5 -2.9 2.5 v 3.2 l 2.9 2.5 -3.2 5.5 -3.6 -1.3 -2.8 1.6 -1 3.7 h -6.4 l -1 -3.7 -2.8 -1.6 -3.6 1.3 -3.2 -5.5 2.9 -2.5 v -3.2 l -2.9 -2.5 3.2 -5.5 3.6 1.3 2.8 -1.6 Z"
                  fill="#e8eaef" />
            <circle r="5.4" fill="#5d636d" />
          </g>
        </g>
      </g>

      <!-- Notch -->
      <path d={`M ${SCR_X + SCR_W / 2 - NOTCH_W / 2} ${SCR_Y}
                h ${NOTCH_W} v ${NOTCH_H - 12}
                a 12 12 0 0 1 -12 12 h ${-(NOTCH_W - 24)}
                a 12 12 0 0 1 -12 -12 Z`} fill="#000" />

      <!-- Notch HUD -->
      { hud !== 'none' && (
        <g transform={`translate(${CARD_X} ${SCR_Y})`}>
          <path d={cardPath(CARD_W, CARD_H, RC, RB)} fill="#000000" />
          <g transform={`translate(0 ${NOTCH_H + 10})`} font-family="var(--body)">

            { (hud === 'connecting' || hud === 'connected') && (
              <g transform="translate(30 12)">
                <rect x="0" y="0" width="72" height="72" rx="18" fill="rgba(255,255,255,0.1)" />
                <g transform="translate(19 19)" fill="none" stroke="#fff" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round">
                  <rect x="0.9" y="3" width="32" height="21" rx="3.5" transform="scale(1.03)" />
                  <path d="M6 9.5h.6M12 9.5h.6M18 9.5h.6M24 9.5h.6M29 9.5h.6M6 15h.6M12 15h.6M18 15h.6M24 15h.6M29 15h.6M12 20.5h13" />
                </g>
                <text x="94" y="30" fill="#fff" font-size="26" font-weight="500">
                  {hud === 'connected' ? 'Connected' : 'Connecting…'}
                </text>
                <text x="94" y="58" fill="rgba(255,255,255,0.6)" font-size="22">{DEVICE}</text>

                { hud === 'connected' ? (
                  <g transform="translate(392 22)" fill="none" stroke="#35c759"
                     stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m0 13 10 10L30 1" />
                  </g>
                ) : (
                  <g transform="translate(392 12)">
                    {[0, 1, 2].map((i) => (
                      <rect x={i * 17} y={36 - [13, 25, 36][i]} width="9.5"
                            height={[13, 25, 36][i]} rx="4.7"
                            fill={i === 0 ? '#fff' : 'rgba(255,255,255,0.28)'} />
                    ))}
                  </g>
                )}
              </g>
            )}

            { hud === 'ready' && (
              <g text-anchor="middle">
                <text x={CARD_W / 2} y="34" fill="#fff" font-size="26" font-weight="500">Ready to pair</text>
                <text x={CARD_W / 2} y="68" fill="rgba(255,255,255,0.6)" font-size="22">Open ReMoKey on your iPhone</text>
                <text x={CARD_W / 2} y="96" fill="rgba(255,255,255,0.6)" font-size="22">and choose this Mac</text>
                <rect x={CARD_W / 2 - 150} y="122" width="300" height="6" rx="3" fill="rgba(255,255,255,0.15)" />
                <rect x={CARD_W / 2 - 150} y="122" width="186" height="6" rx="3" fill="#fff" />
                <text x={CARD_W / 2} y="158" fill="rgba(255,255,255,0.45)" font-size="20">74s remaining</text>
              </g>
            )}

            { hud === 'code' && (
              <g>
                <text x={CARD_W / 2} y="32" fill="#fff" font-size="26" font-weight="500"
                      text-anchor="middle">{DEVICE} wants to pair</text>
                <text x={CARD_W / 2} y="64" fill="rgba(255,255,255,0.6)" font-size="22"
                      text-anchor="middle">Does your iPhone show this code?</text>

                {/* 44x52 tiles, 8pt radius, 26pt rounded monospaced */}
                {['4', '9', '1', '7'].map((d, i) => (
                  <g transform={`translate(${CARD_W / 2 - (4 * 44 * K + 3 * 8 * K) / 2 + i * (44 + 8) * K} 84)`}>
                    <rect x="0" y="0" width={44 * K} height={52 * K} rx={8 * K}
                          fill="rgba(255,255,255,0.1)" />
                    <text x={44 * K / 2} y={52 * K * 0.68} fill="#fff" font-size={26 * K}
                          font-weight="500" text-anchor="middle"
                          style="font-variant-numeric:tabular-nums">{d}</text>
                  </g>
                ))}

                {/* Buttons: 30pt tall, radius 8, affirmative on the right.
                    Neither is a keyboard default — the panel never takes key
                    focus, so a stray keystroke cannot mint a credential. */}
                <g transform={`translate(${CARD_W / 2 - (2 * 130 + 16) * K / 2} 210)`}>
                  <rect x="0" y="0" width={130 * K} height={30 * K} rx={8 * K}
                        fill="rgba(255,255,255,0.14)" />
                  <text x={130 * K / 2} y={30 * K * 0.68} fill="#fff" font-size={13 * K}
                        text-anchor="middle">Not Now</text>
                  <rect x={(130 + 16) * K} y="0" width={130 * K} height={30 * K} rx={8 * K} fill="#fff" />
                  <text x={(130 + 16) * K + 130 * K / 2} y={30 * K * 0.68} fill="#000"
                        font-size={13 * K} font-weight="600" text-anchor="middle">Confirm</text>
                </g>

                <rect x={CARD_W / 2 - 150} y={296} width="300" height="6" rx="3" fill="rgba(255,255,255,0.15)" />
                <rect x={CARD_W / 2 - 150} y={296} width="122" height="6" rx="3" fill="#fff" />
              </g>
            )}
          </g>
        </g>
      )}

      <!-- Glass sheen, over everything on the panel -->
      <rect x={SCR_X} y={SCR_Y} width={SCR_W} height={SCR_H} fill={`url(#sheen-${uid})`} />
    </g>

    <!-- Base -->
    <path d={`M 8 ${SCR_H + 54} H ${VB_W - 8} l -44 46 H 52 Z`} fill={`url(#base-${uid})`} />
    <rect x={VB_W / 2 - 92} y={SCR_H + 54} width="184" height="9" rx="4.5" fill="rgba(0,0,0,0.25)" />
  </svg>
</div>

