---
import { PRODUCT_NAME } from '../config.mjs';
const path = Astro.url.pathname;
const on = (p) => (path === p ? 'page' : undefined);
---
<header class="hdr">
  <div class="hdr__in wrap">
    <a class="mark" href="/" aria-label={`${PRODUCT_NAME} home`}>
      <!-- The app's own mark: a key cap with waves rising out of it. Redrawn
           from the geometry in Scripts/make-app-icons.swift. -->
      <svg viewBox="0 0 1 1" width="22" height="22" aria-hidden="true" class="mark__glyph">
        <g fill="none" stroke="currentColor" stroke-width="0.05" stroke-linecap="round">
          <path d="M 0.375 0.483 A 0.125 0.125 0 0 1 0.625 0.483" />
          <path d="M 0.292 0.483 A 0.208 0.208 0 0 1 0.708 0.483" opacity=".62" />
          <path d="M 0.208 0.483 A 0.292 0.292 0 0 1 0.792 0.483" opacity=".4" />
        </g>
        <circle cx="0.5" cy="0.483" r="0.022" fill="currentColor" />
        <rect x="0.35" y="0.492" width="0.3" height="0.267" rx="0.067" fill="currentColor" />
      </svg>
      <span>{PRODUCT_NAME}</span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <a href="/download/" aria-current={on('/download/')}>Download</a>
      <a href="/support/" aria-current={on('/support/')}>Support</a>
      <a href="/privacy/" aria-current={on('/privacy/')}>Privacy</a>

      <!-- aria-pressed carries the state ("dark on"), so the label can stay
           constant instead of flipping mid-press under a screen reader. -->
      <button class="theme-toggle" type="button" aria-label="Dark theme"
              aria-pressed="false" data-theme-toggle>
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="theme-toggle__sun">
          <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.4" />
            <path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7" />
          </g>
        </svg>
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="theme-toggle__moon">
          <path d="M20.2 14.9A8.6 8.6 0 0 1 9.1 3.8a8.6 8.6 0 1 0 11.1 11.1z"
                fill="none" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  /* The other half lives in Base.astro's inline head script, which applies the
     stored theme before first paint. This half flips it, and keeps every
     surface that mirrors the theme — the toggle's aria state and the
     theme-color meta — in step through one helper. */
  const THEME_COLOR = { light: '#f4f1e9', dark: '#111214' };
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const toggles = [...document.querySelectorAll('[data-theme-toggle]')];

  function apply(dark) {
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    for (const b of toggles) b.setAttribute('aria-pressed', String(dark));
    meta?.setAttribute('content', dark ? THEME_COLOR.dark : THEME_COLOR.light);
  }

  apply(root.dataset.theme === 'dark');
  for (const btn of toggles) {
    btn.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      apply(dark);
      try {
        localStorage.setItem('rk-theme', dark ? 'dark' : 'light');
      } catch {
        /* Denied storage only means the choice lasts one page. */
      }
    });
  }

  /* Back/forward-cache restores freeze the DOM as it was when the page was
     left — toggle dark on another page, press Back, and this page would come
     back light while localStorage says dark. Neither script re-runs on a
     bfcache restore; pageshow is the hook that does fire. */
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    let dark = false;
    try {
      dark = localStorage.getItem('rk-theme') === 'dark';
    } catch {
      /* Unreadable storage falls back to the light default. */
    }
    apply(dark);
  });

  /* The header hairline. State, not motion: it belongs to the header on every
     page — not to the landing page's scroll engine, which does not run on the
     other pages and never runs under prefers-reduced-motion. */
  const stuck = () => root.classList.toggle('is-stuck', scrollY > 8);
  addEventListener('scroll', stuck, { passive: true });
  stuck();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    /* Semi-opaque rather than transparent: the header crosses full-bleed art
       further down the narrative and must stay legible over all of it. */
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  /* `.is-stuck` is set once the page has scrolled off the top, so the hairline
     only appears when there is content behind the header to separate from. */
  :global(html.is-stuck) .hdr {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }

  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    /* Block padding, not just line-height, so the home link clears the 44px
       pointer-target floor rather than the 27px its text alone gave it. */
    padding-block: 0.72rem;
    color: var(--text);
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .mark__glyph { color: var(--signal-ink); flex: none; }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.4rem + 1.6vw, 1.9rem);
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .hdr__nav a {
    color: var(--text-dim);
    text-decoration: none;
    padding-block: 0.76rem;
    transition: color 0.18s var(--ease);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line-lit);
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease),
                background-color 0.18s var(--ease);
  }
  .theme-toggle:hover { color: var(--text); background: var(--well); }
  /* Show the state you would switch TO, which is how every OS draws it. */
  .theme-toggle__sun { display: none; }
  :global(html[data-theme='dark']) .theme-toggle__moon { display: none; }
  :global(html[data-theme='dark']) .theme-toggle__sun { display: block; }

  /* The wordmark plus three nav items overran a 320px viewport and pushed the
     document 15px wide — `overflow-x: clip` on <body> does not contain overflow
     that reaches the root element, so it was a real horizontal scrollbar on the
     smallest phones still in use. Two steps down rather than a hamburger: three
     links do not need a menu, they need less letter-spacing. */
  @media (max-width: 26rem) {
    .hdr__nav { font-size: 0.8125rem; gap: 0.85rem; }
    .mark { font-size: 0.98rem; gap: 0.45rem; }
    .theme-toggle { width: 32px; height: 32px; }
  }
  @media (max-width: 21rem) {
    /* Glyph only. The <a> keeps its aria-label, so the home link is still
       named for assistive tech. */
    .mark span { display: none; }
  }
  .hdr__nav a:hover { color: var(--text); }
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -1px 0 var(--signal-ink);
  }
</style>
