---
// Two devices and an arrow. Deliberately line art: the launch state has no
// screenshots, and outlines carry the idea without looking like a gap where a
// screenshot should be. Swap for real device frames when screenshots exist.
---
<svg viewBox="0 0 420 150" role="img" aria-label="An iPhone sending input to a Mac"
     style="width:100%;max-width:420px;height:auto;color:var(--muted)">
  <!-- iPhone -->
  <rect x="8" y="20" width="62" height="112" rx="12"
        fill="none" stroke="currentColor" stroke-width="2"/>
  <line x1="28" y1="30" x2="50" y2="30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <!-- arrow -->
  <line x1="92" y1="76" x2="150" y2="76" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <polyline points="140,68 150,76 140,84" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Mac -->
  <rect x="172" y="28" width="216" height="132" rx="8"
        fill="none" stroke="currentColor" stroke-width="2"/>
  <line x1="172" y1="140" x2="388" y2="140" stroke="currentColor" stroke-width="2"/>
</svg>
